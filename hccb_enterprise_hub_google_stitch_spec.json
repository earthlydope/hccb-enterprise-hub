  "project": {
    "id": "hccb-enterprise-experience-hub",
    "name": "HCCB Enterprise Experience Hub",
    "tagline": "Transforming Employee Experience Through a Unified Digital Workplace",
    "app_type": "enterprise_employee_experience_platform",
    "generation_target": "Google Stitch",
    "primary_platforms": [
      "responsive_web",
      "mobile_web",
      "teams_embedded_experience"
    ],
    "business_objective": "Create one intelligent, mobile-first digital workplace connecting employees to information, services, applications, collaboration, analytics and AI.",
    "source_scope": [
      "Employee Engagement Dashboard 1(1).docx",
      "HCCB_Enterprise_Hub_Executive_Deck(1).pptx"
    ],
    "source_fidelity_rule": "Use source-derived features and terminology as authoritative. Where implementation details are not specified in the source, use the recommendations explicitly marked as recommended_or_inferred.",
    "stitch_master_instruction": "Design and prototype a production-grade HCCB Enterprise Experience Hub. The product must feel like a premium enterprise employee super-app rather than a document intranet. Build all screens, responsive states, navigation, interactions, empty/loading/error states, mobile variants, role-aware personalization, AI assistant flows, global search, employee self-service, approvals, news, learning, recognition, communities, analytics and application launchers described in this JSON. Use the official HCCB visual identity derived from https://www.hccb.in/ and never redraw or approximate the HCCB logo. Use official vendor/product logos only when the vendor is explicitly named. Make the experience mobile-first for frontline and field employees while remaining excellent on desktop."
  },
  "branding": {
    "brand_name": "HCCB",
    "full_name": "Hindustan Coca-Cola Beverages Pvt. Ltd.",
    "brand_reference_url": "https://www.hccb.in/",
    "logo": {
      "usage": "official_only",
      "instruction": "Extract/use the official HCCB logo from the HCCB brand/reference URL or an approved supplied asset. Do not recreate the logo as text, SVG paths or an AI-generated approximation.",
      "placement": {
        "desktop": "top-left of global header",
        "mobile": "top-left compact header",
        "login": "centered above sign-in card"
      },
      "clear_space": "minimum 16px around the rendered mark",
      "background_rule": "Prefer white or high-contrast neutral surfaces behind the official logo."
    },
    "design_system_source": {
      "mode": "derive_from_reference_url",
      "url": "https://www.hccb.in/",
      "extract": [
        "brand colors",
        "typographic character",
        "button character",
        "corner radius cues",
        "image treatment"
      ],
      "do_not_copy": [
        "marketing-site layout",
        "public-site navigation"
      ],
      "fallback_if_extraction_unavailable": {
        "primary": "#F40009",
        "surface": "#FFFFFF",
        "text_primary": "#171717",
        "text_secondary": "#5F6368",
        "border": "#E7E7E7",
        "background": "#F7F7F8",
        "note": "Fallback palette only; official extracted brand tokens take precedence."
      }
    },
    "visual_direction": {
      "keywords": [
        "modern enterprise",
        "premium",
        "clean",
        "people-first",
        "high information clarity",
        "mobile-first",
        "warm but professional",
        "modular employee super-app"
      ],
      "avoid": [
        "dense legacy intranet layout",
        "excessive gradients",
        "neon styling",
        "cartoon illustrations",
        "overuse of Coca-Cola beverage imagery",
        "generic SaaS purple/blue branding",
        "tiny dashboard typography"
      ],
      "surface_style": "white cards on soft-neutral background, strong hierarchy, restrained shadows, generous spacing",
      "icon_style": "rounded enterprise line/filled icons; official product logos kept unmodified"
    }
  },
